# Copy to .env for local development. Keep real credentials out of git, logs,
# screenshots, and demo recordings. This file contains placeholders only.
# Google OAuth client/tokens are registered in gog's credential store.
# OpenClaw generates its local gateway token in .runtime/state/openclaw.json.
# Approval authority uses authenticated Telegram + one-use database records;
# no separate APPROVAL_SIGNING_KEY is consumed by this implementation.
APPLYPILOT_ENV=development
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_BOT_TOKEN=
APPLYPILOT_TEST_GMAIL_ACCOUNT=synthetic-test-account@gmail.com
APPLYPILOT_TEST_CALENDAR_ID=synthetic-test-calendar@group.calendar.google.com
# SQLite path must be on local transactional disk, never a GCS FUSE mount.
APPLYPILOT_STATE_DB=./state/applypilot.sqlite
APPLYPILOT_GCS_BUCKET=
APPLYPILOT_ARCHIVE_PREFIX=applypilot/production
APPLYPILOT_CLOUD_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434


# One-use tagged enrollment key; retain cloud node state securely after enrollment.
TAILSCALE_AUTH_KEY=
