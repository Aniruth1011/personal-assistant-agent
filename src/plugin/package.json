{
  "name": "openclaw-plugin-applypilot-agent",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && mkdir -p dist/fixtures && cp -R ../../fixtures/. dist/fixtures/ && openclaw plugins build --entry ./dist/src/plugin/src/index.js",
    "plugin:validate": "npm run build && mkdir -p dist/fixtures && cp -R ../../fixtures/. dist/fixtures/ && openclaw plugins validate --entry ./dist/src/plugin/src/index.js",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.11.2 <2026.12.0"
  },
  "dependencies": {
    "@google-cloud/storage": "9.0.0",
    "@js-temporal/polyfill": "0.5.1",
    "typebox": "1.3.35",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "openclaw": "2026.11.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/src/plugin/src/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.11.2"
    },
    "build": {
      "openclawVersion": "2026.11.2"
    }
  },
  "overrides": {
    "brace-expansion": "5.0.13",
    "glob": "14.0.6",
    "ip-address": "10.7.6",
    "minimatch": "11.0.1",
    "postcss-selector-parser": "7.2.1",
    "undici@^6": "6.29.1",
    "zod": "4.6.7",
    "npm": "12.2.3"
  }
}
