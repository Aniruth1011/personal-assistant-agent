{
  "name": "applypilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenClaw proactive personal assistant with email, calendar, web search and to-do management",
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:env": "node scripts/check-env.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:secrets"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@google-cloud/storage": "9.0.0",
    "@js-temporal/polyfill": "0.5.1",
    "socks-proxy-agent": "10.1.0",
    "typebox": "1.3.35",
    "zod": "4.6.7"
  }
}
